---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ServiceLayout from '../../components/ServiceLayout.astro';
import { mobileServices } from '../../data/mobileServices';

export async function getStaticPaths() {
  return mobileServices.map((s) => ({ params: { slug: s.slug }, props: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = mobileServices.find((s) => s.slug === slug);
if (!service) throw new Error(`Unknown mobile service: ${slug}`);
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  keywords={service.keywords}
  ogType="article"
  canonicalPath={`/mobile-app-development/${service.slug}/`}
>
  <Navbar />
  <ServiceLayout service={service} />
  <Footer />
</Layout>
