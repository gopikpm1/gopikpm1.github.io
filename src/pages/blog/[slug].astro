---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ServiceLayout from '../../components/ServiceLayout.astro';
import { seoPages } from '../../data/seoPages';

export async function getStaticPaths() {
  return seoPages.map((s) => ({ params: { slug: s.slug }, props: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = seoPages.find((s) => s.slug === slug);
if (!service) throw new Error(`Unknown blog post: ${slug}`);
---
<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  keywords={service.keywords}
  ogType="article"
  canonicalPath={`/blog/${service.slug}/`}
>
  <Navbar />
  <ServiceLayout
    service={service}
    basePath="/blog"
    hubPath="/blog/"
    hubLabel="Blog"
    hubDescription="Searchable guides on hiring local developers, choosing a framework (Hybrid vs Native, Ionic vs React Native, React vs Angular), app cost and growing your business with an app."
  />
  <Footer />
</Layout>
