---
import { navLinks } from '../data/site';
import { seoPages, moreMenuGroups } from '../data/seoPages';

const bySlug = new Map(seoPages.map((s) => [s.slug, s]));
---

<!-- Navigation -->
<nav class="navbar" aria-label="Main navigation">
  <div class="container">
    <div class="nav-brand"><a href="/#home" class="nav-brand-link" aria-label="Gopi M — home"><span class="brand-mark" aria-hidden="true">g.</span> gopi<span class="brand-dot">m.</span></a></div>
    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <ul class="nav-menu" id="nav-menu">
      {
        navLinks.map((link) => (
          link.label === 'Blog' ? (
            <li class="nav-item nav-dropdown">
              <button
                type="button"
                class="nav-link nav-drop-btn"
                aria-expanded="false"
                aria-controls="nav-blog-panel"
              >
                Blog <span class="nav-caret" aria-hidden="true">▾</span>
              </button>
              <div class="nav-drop-panel" id="nav-blog-panel">
                <div class="nav-drop-search">
                  <label class="nav-drop-search-label" for="nav-blog-search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <span class="sr-only">Search blog guides</span>
                  </label>
                  <input
                    id="nav-blog-search"
                    class="nav-drop-search-input"
                    type="search"
                    placeholder="Search guides…"
                    autocomplete="off"
                  />
                  <a class="nav-drop-search-go" href="/blog/" title="Open full blog with search">
                    View all <span aria-hidden="true">→</span>
                  </a>
                </div>
                <p class="nav-drop-empty" id="nav-blog-empty" hidden>No guides match that search.</p>
                <div class="nav-drop-grid">
                  {moreMenuGroups.map((g) => (
                    <div class="nav-drop-group">
                      <p class="nav-drop-heading">{g.heading}</p>
                      <ul>
                        {g.links.map((slug) => {
                          const s = bySlug.get(slug);
                          if (!s) return null;
                          return (
                            <li
                              data-search={`${s.label} ${s.tagline} ${s.keywords}`.toLowerCase()}
                            >
                              <a class="nav-drop-link" href={`/blog/${s.slug}/`}>{s.label}</a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  ))}
                </div>
                <p class="nav-drop-all"><a href="/blog/">See all blog guides →</a></p>
              </div>
            </li>
          ) : (
            <li class="nav-item">
              <a
                href={link.href}
                class:list={['nav-link', link.href === '/#contact' && 'nav-contact']}
              >
                {link.label}
              </a>
            </li>
          )
        ))
      }
    </ul>
  </div>
</nav>

<script>
  // Live filter for the Blog dropdown search box.
  const navSearch = document.getElementById('nav-blog-search') as HTMLInputElement | null;
  if (navSearch) {
    const panel = navSearch.closest('.nav-drop-panel');
    const emptyMsg = panel?.querySelector('.nav-drop-empty') as HTMLElement | null;
    const items = Array.from(panel?.querySelectorAll<HTMLElement>('.nav-drop-group li') ?? []);

    const filter = () => {
      const q = navSearch.value.trim().toLowerCase();
      let shown = 0;
      for (const li of items) {
        const match = !q || (li.dataset.search || '').includes(q);
        li.hidden = !match;
        if (match) shown += 1;
      }
      if (emptyMsg) emptyMsg.hidden = shown !== 0 || items.length === 0;
    };

    navSearch.addEventListener('input', filter);

    // Enter jumps to the full blog search results page.
    navSearch.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        const q = navSearch.value.trim();
        window.location.href = q ? `/blog/?q=${encodeURIComponent(q)}` : '/blog/';
      }
    });

    // Don't let typing in the box close the dropdown via the outside-click handler.
    navSearch.addEventListener('click', (e) => e.stopPropagation());
  }
</script>

