---
import { navLinks } from '../data/site';
---

<!-- Navigation -->
<nav class="navbar">
  <div class="container">
    <div class="nav-brand">Gopi M</div>
    <ul class="nav-menu">
      {
        navLinks.map((link, index) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', index === 0 && 'active']}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
