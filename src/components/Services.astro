---
import { services } from '../data/services';
---

<section id="services" class="services">
  <div class="container">
    <p class="eyebrow">WHAT I CAN DO FOR YOU</p>
    <h2 class="section-title">From first idea to final release.</h2>
    <p class="section-description">A hands-on engineering partner for your next product, your toughest bug, or your next big step.</p>
    <div class="service-grid">
      {services.slice(0, 3).map((service, index) => (
        <article class="service-card">
          <div class="service-card-top"><i class={service.icon} aria-hidden="true"></i><span>0{index + 1}</span></div>
          <p class="service-label">{service.tag}</p>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <ul>{service.points.map((point) => <li>{point}</li>)}</ul>
          <a href={service.cta.href}>{service.cta.label} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
    <details class="more-services">
      <summary>Explore all services <span aria-hidden="true">+</span></summary>
      <div class="service-grid">
        {services.slice(3).map((service, index) => (
          <article class="service-card">
            <div class="service-card-top"><i class={service.icon} aria-hidden="true"></i><span>{String(index + 4).padStart(2, '0')}</span></div>
            <p class="service-label">{service.tag}</p>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <ul>{service.points.map((point) => <li>{point}</li>)}</ul>
            <a href={service.cta.href}>{service.cta.label} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </details>
  </div>
</section>