---
import { contacts } from '../data/site';
---

<!-- Contact Section -->
<section id="contact" class="contact">
  <div class="container">
    <p class="eyebrow">HAVE SOMETHING IN MIND?</p>
    <h2 class="section-title">Let's make your next<br /><span>big idea happen.</span></h2>
    <p class="section-description">
      I'm open to discussing new projects, innovative ideas, and opportunities to be part of your
      vision.
    </p>

    <div class="contact-methods">
      {
        contacts.map((contact) => (
          <a
            href={contact.href}
            class="contact-card"
            target={contact.external ? '_blank' : undefined}
            rel={contact.external ? 'noopener noreferrer' : undefined}
            aria-label={contact.external ? `${contact.title}: ${contact.detail} (opens in a new tab)` : undefined}
          >
            <i class={contact.icon} aria-hidden="true" />
            <h3>{contact.title}</h3>
            <p>{contact.detail}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
