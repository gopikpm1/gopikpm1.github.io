---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />


    <!-- Canonical + robots (max indexing, rich previews) -->
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!-- Primary SEO -->
    <meta name="author" content="Gopi M" />
    <meta name="theme-color" content="#0f172a" />
    <meta
      name="keywords"
      content="freelance mobile app developer, freelance web developer chennai, freelance desktop app developer, electron developer india, windows app developer, mac app developer, pwa developer, java plugin developer, cordova plugin developer, capacitor plugin developer, c# library developer, nuget package developer, npm package developer, asp.net developer, c# developer, sql server developer, dotnet developer india, enterprise saas developer, field service management software, fsm app developer, react native developer india, expo developer, ios android app developer, ai app developer, webRTC developer, astro web developer, hire app developer"
    />
    <meta name="geo.region" content="IN-TN" />
    <meta name="geo.placename" content="Chennai, Tamil Nadu, India" />

    <!-- Open Graph (Facebook / LinkedIn / WhatsApp) -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Gopi M — Mobile, Web & Desktop Developer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={siteUrl + '/images/profile.jpg'} />
    <meta property="og:image:alt" content="Gopi M — Senior Cross-Platform Mobile, Web & Desktop Developer" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + '/images/profile.jpg'} />
    <meta name="twitter:image:alt" content="Gopi M — Senior Cross-Platform Mobile, Web & Desktop Developer" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- JSON-LD structured data: Person, WebSite, Projects -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(projectsSchema)} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5KDJ30TR26"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-5KDJ30TR26');
    </script>
  </head>
  <body>
    <slot />

    <script>
      // Smooth scrolling for navigation links
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href') || '');
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start',
            });
          }
        });
      });

      // Mobile menu toggle
      const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const navContainer = document.querySelector('.navbar .container');

      if (navToggle && navContainer) {
        navToggle.addEventListener('click', () => {
          const open = navContainer.classList.toggle('nav-open');
          navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        });

        // Close the menu after tapping a link
        navContainer.querySelectorAll<HTMLAnchorElement>('.nav-link').forEach((link) => {
          link.addEventListener('click', () => {
            navContainer.classList.remove('nav-open');
            navToggle.setAttribute('aria-expanded', 'false');
            navToggle.setAttribute('aria-label', 'Open menu');
          });
        });
      }

      // Active navigation link
      window.addEventListener('scroll', () => {
        let current = '';
        const sections = document.querySelectorAll<HTMLElement>('section');

        sections.forEach((section) => {
          const sectionTop = section.offsetTop;
          if (window.pageYOffset >= sectionTop - 200) {
            current = section.getAttribute('id') || '';
          }
        });

        document.querySelectorAll<HTMLAnchorElement>('.nav-link').forEach((link) => {
          link.classList.remove('active');
          if ((link.getAttribute('href') || '').slice(1) === current) {
            link.classList.add('active');
          }
        });
      });

      // Intersection Observer for animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -100px 0px',
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.opacity = '1';
            (entry.target as HTMLElement).style.transform = 'translateY(0)';
          }
        });
      }, observerOptions);

      document.querySelectorAll('.skill-card, .project-card, .timeline-item').forEach((el) => {
        (el as HTMLElement).style.opacity = '0';
        (el as HTMLElement).style.transform = 'translateY(20px)';
        (el as HTMLElement).style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        observer.observe(el);
      });
    </script>
  </body>
</html>
